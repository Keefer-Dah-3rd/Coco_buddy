{
  "$description": "Coco design tokens: the one source for the Swift code and the Figma variables and text styles. Edit in Figma and sync (docs/DESIGN_SYSTEM.md), or edit here and push to Figma. Keys are Figma names; `swift` is the Swift identifier.",
  "$version": 1,
  "primitives": {
    "$collection": "Primitives",
    "sand/50": "#F3F1EC",
    "sand/100": "#EFECE5",
    "sand/150": "#E8E5DE",
    "sand/175": "#E6E1D7",
    "sand/200": "#D9D5CB",
    "sand/250": "#D3CDC1",
    "sand/400": "#A6A196",
    "sand/450": "#9C988E",
    "sand/600": "#6E6A61",
    "sand/650": "#64615A",
    "sand/800": "#363531",
    "sand/850": "#272724",
    "sand/900": "#1D1E1B",
    "sand/925": "#1C1C1A",
    "sand/950": "#1A1A18",
    "orange/400": "#FF6A33",
    "orange/500": "#FF5A1F",
    "amber/100": "#FFE6B0"
  },
  "color": {
    "$collection": "Color",
    "$modes": ["Light", "Dark"],
    "surface/paper": { "swift": "paper", "light": "sand/50", "dark": "sand/925", "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL"], "description": "Panel and window background; text on ink fills." },
    "surface/well": { "swift": "well", "light": "sand/150", "dark": "sand/850", "scopes": ["FRAME_FILL", "SHAPE_FILL"], "description": "Recessed areas: fields, cards, hover." },
    "ink/primary": { "swift": "ink", "light": "sand/950", "dark": "sand/100", "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"], "description": "Primary text; selected-segment fill." },
    "ink/secondary": { "swift": "inkSecondary", "light": "sand/600", "dark": "sand/450", "scopes": ["SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"], "description": "Supporting text, mono labels." },
    "ink/tertiary": { "swift": "inkTertiary", "light": "sand/400", "dark": "sand/650", "scopes": ["SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"], "description": "Placeholders, metadata, disabled hints." },
    "line/hairline": { "swift": "hairline", "light": "sand/200", "dark": "sand/800", "scopes": ["FRAME_FILL", "SHAPE_FILL", "STROKE_COLOR"], "description": "1 pt borders and dividers." },
    "accent/default": { "swift": "accent", "light": "orange/500", "dark": "orange/400", "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"], "description": "The one accent: primary keys, focus, Coco's tag." },
    "accent/on-accent": { "swift": "onAccent", "light": "sand/950", "dark": "sand/950", "scopes": ["SHAPE_FILL", "TEXT_FILL"], "description": "Text on accent fills; dark in both modes, like a printed key cap." },
    "lcd/screen": { "swift": "lcd", "light": "sand/900", "dark": "sand/900", "scopes": ["FRAME_FILL", "SHAPE_FILL"], "description": "The countdown chip's LCD; the same in both modes." },
    "lcd/phosphor": { "swift": "phosphor", "light": "amber/100", "dark": "amber/100", "scopes": ["SHAPE_FILL", "TEXT_FILL"], "description": "Digits on the LCD." }
  },
  "brand": {
    "$collection": "Brand",
    "coco/fur": { "swift": "fur", "value": "#221D1B" },
    "coco/fur-rim": { "swift": "rim", "value": "#5E5550", "description": "Warm grey edge so a black dog still reads on a dark desktop." },
    "coco/fur-shade": { "swift": "furShade", "value": "#3A322F" },
    "coco/white": { "swift": "white", "value": "#F4F0E8" },
    "coco/white-edge": { "swift": "whiteEdge", "value": "#CFC7BB" },
    "coco/inner-ear": { "swift": "innerEar", "value": "#7A5446" },
    "coco/nose": { "swift": "nose", "value": "#141112" },
    "coco/eye": { "swift": "eye", "value": "#1A110D" },
    "coco/eye-rim": { "swift": "eyeRim", "value": "#86675A" },
    "coco/eye-closed": { "swift": "closedEye", "value": "#D7CEC4" },
    "coco/mouth-line": { "swift": "mouthLine", "value": "#2A2220" },
    "coco/mouth-inside": { "swift": "mouthInside", "value": "#3D1D24" },
    "coco/tongue": { "swift": "tongue", "value": "#EC8A9B" },
    "coco/tongue-groove": { "swift": "tongueGroove", "value": "#C8687C" },
    "coco/collar": { "swift": "collar", "value": "#151515" },
    "coco/collar-rim": { "swift": "collarRim", "value": "#4A4542" },
    "coco/tag-face": { "swift": "tagFace", "value": "#ECEAE5" },
    "coco/tag-light": { "swift": "accent", "value": "orange/500", "description": "Collar-tag light, focus ring and sparkles." },
    "coco/ink": { "swift": "ink", "value": "#2B2A27", "description": "Thought dots and sleep Zs." },
    "icon/tile": { "swift": "iconTile", "value": "sand/50" },
    "icon/floor": { "swift": "iconFloor", "value": "sand/175" },
    "icon/stroke": { "swift": "iconStroke", "value": "sand/250" }
  },
  "space": {
    "$collection": "Space",
    "xxxs": { "swift": "xxxs", "value": 2 },
    "xxs": { "swift": "xxs", "value": 4 },
    "xs": { "swift": "xs", "value": 6 },
    "sm": { "swift": "sm", "value": 8 },
    "md": { "swift": "md", "value": 10, "description": "Row and card padding." },
    "lg": { "swift": "lg", "value": 12 },
    "xl": { "swift": "xl", "value": 16, "description": "Panel inset." },
    "xxl": { "swift": "xxl", "value": 24, "description": "Window inset." },
    "xxxl": { "swift": "xxxl", "value": 32 }
  },
  "radius": {
    "$collection": "Radius",
    "bar": { "swift": "bar", "value": 1.5, "description": "Progress segments." },
    "check": { "swift": "check", "value": 3.5, "description": "Task checkbox." },
    "keycap": { "swift": "keycap", "value": 4, "description": "Keycaps, chips, the LCD." },
    "key": { "swift": "key", "value": 5, "description": "Key buttons and inline fields." },
    "control": { "swift": "control", "value": 6, "description": "Segmented controls, fields, banners." },
    "card": { "swift": "card", "value": 8 },
    "bubble": { "swift": "bubble", "value": 9, "description": "Coco's speech bubble." },
    "section": { "swift": "section", "value": 10, "description": "Settings and Connections sections." },
    "panel": { "swift": "panel", "value": 12 }
  },
  "metrics": {
    "$collection": "Metrics",
    "stroke/hairline": { "swift": "hairline", "value": 1, "scopes": ["STROKE_FLOAT"] },
    "opacity/disabled": { "swift": "disabledOpacity", "value": 0.4, "scopes": ["OPACITY"] },
    "opacity/pressed": { "swift": "pressedOpacity", "value": 0.85, "scopes": ["OPACITY"] },
    "panel/width": { "swift": "panelWidth", "value": 340, "scopes": ["WIDTH_HEIGHT"] },
    "panel/height": { "swift": "panelHeight", "value": 540, "scopes": ["WIDTH_HEIGHT"] }
  },
  "fonts": {
    "sans": { "swift": "default", "figma": "Inter", "description": "SF Pro (the system font) in the app. Figma's renderer can't draw SF Pro, so Inter stands in on the canvas." },
    "mono": { "swift": "monospaced", "figma": "Roboto Mono", "description": "SF Mono in the app. Figma's renderer has no SF Mono, so Roboto Mono stands in on the canvas." }
  },
  "typography": {
    "Display/Countdown": { "swift": "displayCountdown", "family": "mono", "weight": "light", "size": 62 },
    "Display/Count": { "swift": "displayCount", "family": "sans", "weight": "semibold", "size": 30 },
    "Title/Large": { "swift": "titleLarge", "family": "sans", "weight": "semibold", "size": 22 },
    "Title/Section": { "swift": "titleSection", "family": "sans", "weight": "semibold", "size": 15 },
    "Speech/Panel": { "swift": "speechPanel", "family": "sans", "weight": "medium", "size": 13.5 },
    "Speech/Bubble": { "swift": "speechBubble", "family": "sans", "weight": "medium", "size": 12.5 },
    "Body/Default": { "swift": "body", "family": "sans", "weight": "regular", "size": 13 },
    "Body/Emphasis": { "swift": "bodyEmphasis", "family": "sans", "weight": "medium", "size": 13 },
    "Body/Small": { "swift": "bodySmall", "family": "sans", "weight": "regular", "size": 12 },
    "Body/Small Emphasis": { "swift": "bodySmallEmphasis", "family": "sans", "weight": "medium", "size": 12 },
    "Caption": { "swift": "caption", "family": "sans", "weight": "regular", "size": 11 },
    "Mono/Label": { "swift": "monoLabel", "family": "mono", "weight": "semibold", "size": 10, "tracking": 0.8, "uppercase": true },
    "Mono/Key": { "swift": "monoKey", "family": "mono", "weight": "semibold", "size": 11, "tracking": 0.6, "uppercase": true },
    "Mono/Key Compact": { "swift": "monoKeyCompact", "family": "mono", "weight": "semibold", "size": 10, "tracking": 0.6, "uppercase": true },
    "Mono/Value": { "swift": "monoValue", "family": "mono", "weight": "medium", "size": 11 },
    "Mono/Mark": { "swift": "monoMark", "family": "mono", "weight": "bold", "size": 10 },
    "Mono/Tiny": { "swift": "monoTiny", "family": "mono", "weight": "semibold", "size": 9 }
  }
}
